# Copy to .env and adjust as needed. .env is gitignored.

# --- Ports (host-side, also used as the container's internal bind port) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backend (FastAPI, backend/app/core/config.py::Settings) ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=200

# --- Frontend (Nuxt) ---
# NUXT_PUBLIC_* vars are exposed to the browser (Nuxt public runtimeConfig convention).
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
