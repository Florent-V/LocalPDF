# Copy to .env and adjust as needed. .env is gitignored.

# --- Ports ---
BACKEND_PORT=8010
FRONTEND_PORT=3010
MAX_UPLOAD_MB=200

# --- Authentication: the API is the OAuth client (BFF) ---
# Everything else (endpoints, signing keys) is read from the server's discovery
# document. The value must be EXACTLY the "issuer" the server publishes.
OAUTH_ISSUER=http://localhost:8080
# Application declared on the OAuth server (redirect URI
# http://localhost:3010/auth/callback, back-channel logout URI
# http://host.docker.internal:3010/auth/backchannel-logout).
OAUTH_CLIENT_ID=localpdf-dev
OAUTH_CLIENT_SECRET=
