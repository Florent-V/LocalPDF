# Copy to .env (gitignored, chmod 600): cp .env.example .env
# Same variables in ImageConverter and pdf-tools. Documentation: docs/deploiement.md

# ── Authentication: the API is the OAuth client (BFF) ────────────────────
# Everything else (endpoints, signing keys) is read from
# <OAUTH_ISSUER>/.well-known/oauth-authorization-server.
# Exact issuer of the OAuth server, as it publishes it (trailing slash included).
OAUTH_ISSUER=http://localhost:8080
# Application declared on the OAuth server (client ID and secret it generated)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ── Backend ──────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200

# ── Dev (make dev): http://localhost:FRONTEND_PORT ───────────────────────
# Declare on the OAuth server: redirect URI http://localhost:FRONTEND_PORT/auth/callback,
# back-channel logout URI http://host.docker.internal:FRONTEND_PORT/auth/backchannel-logout
# (make urls prints them). PUBLIC_ORIGIN, APP_ENV=dev and COOKIE_SECURE=false are set
# by docker-compose.override.yml: leave them out of the dev .env.
FRONTEND_PORT=3010
BACKEND_PORT=8010

# ── Production (make prod-up / prod-deploy): behind the host's Caddy ──────
# Public origin of the app, no trailing slash: the redirect URI is
# {PUBLIC_ORIGIN}/auth/callback, the back-channel logout URI
# {PUBLIC_ORIGIN}/auth/backchannel-logout
# PUBLIC_ORIGIN=https://pdf.mydomain.com
# Host port of the web container, bound to 127.0.0.1
# REMOTE_FRONTEND_PORT=3010
