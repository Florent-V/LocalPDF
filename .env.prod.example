# Copy to .env.prod (gitignored) and fill it: cp .env.prod.example .env.prod && chmod 600 .env.prod
# Documentation: docs/deploiement.md

# Host port of the web container, bound to 127.0.0.1 (the host's Caddy proxies to it)
FRONTEND_PORT=3010
MAX_UPLOAD_MB=200

# Public origin of this app: the redirect URI is {PUBLIC_ORIGIN}/auth/callback
PUBLIC_ORIGIN=https://pdf.mydomain.com

# OAuth server: its issuer, exactly as it publishes it in
# /.well-known/oauth-authorization-server (no trailing slash unless it has one)
OAUTH_ISSUER=https://oauth.mydomain.com

# Application declared on the OAuth server (make prod-app on the OAuth server):
# redirect URI {PUBLIC_ORIGIN}/auth/callback,
# back-channel logout URI {PUBLIC_ORIGIN}/auth/backchannel-logout
OAUTH_CLIENT_ID=localpdf
OAUTH_CLIENT_SECRET=
