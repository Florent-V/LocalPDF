# Production image: `nuxt generate` (static single-page app), then only the
# files in a Caddy image. No Node at runtime.
FROM node:22-alpine AS build

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN npm install -g pnpm@11.17.0 \
    && pnpm install --frozen-lockfile --ignore-scripts && pnpm exec nuxt prepare

COPY . .
RUN pnpm exec nuxt generate


FROM caddy:2-alpine

COPY Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/.output/public /srv

EXPOSE 80
